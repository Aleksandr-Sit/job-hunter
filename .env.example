# ── AI-провайдеры (оценка вакансий) ────────────────────────────────────────────
# Матчер работает поверх ЛЮБОГО OpenAI-совместимого провайдера и при отказе
# одного (402/401/403) переходит к следующему. Участвует только тот, кто есть
# в AI_PROVIDER_ORDER И у кого задан ключ — одного ключа без порядка мало.
AI_PROVIDER_ORDER=openrouter            # через запятую: openrouter,groq,cerebras

# Основной. Регистрация: openrouter.ai → Keys. Модель gpt-oss-120b — под неё
# калибровались пороги 42/55, смена модели тихо сдвинет отбор.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-oss-120b    # необязательно, это значение по умолчанию

# Запасной (любой из). У Groq модель по умолчанию НЕ gpt-oss-120b — задавать явно.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_API_KEY=csk-...              # cloud.cerebras.ai → API Keys
# CEREBRAS_MODEL=gpt-oss-120b

# ── Telegram Bot (отправка карточек и кнопки) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAH... # @BotFather
TELEGRAM_CHAT_ID=123456789           # узнать у @userinfobot; бот отвечает ТОЛЬКО этому чату
