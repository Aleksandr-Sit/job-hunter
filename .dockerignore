# Контекст сборки. Без этого файла в каждую сборку уезжали база, логи и .env
# (~25 МБ), а в образ запекались личные данные (ревизия 17.09.2026).

# Данные и секреты
data/
.env
.env.*
!.env.example

# Личный профиль кандидата: в контейнер он приходит bind-mount'ом, а не образом.
# Примеры оставляем: на них падает запасной путь чтения профиля.
config/profile/*
!config/profile/*.example

# Не нужно в рантайме
docs/
tests/
.git/
.github/
*.md
!README.md

# Мусор Python и окружения
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
